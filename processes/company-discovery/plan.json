                            "semantic": "discovery.capture.v1"
                          },
                          "request_digest": {
                            "semantic": "recovery.request_digest"
                          },
                          "status": {
                            "semantic": "recovery.status"
                          }
                        },
                        "outcomes": [
                          "completed"
                        ],
                        "effects": [
                          "network.read"
                        ],
                        "failure": "error"
                      },
                      "schema": "aeltum.node.v2",
                      "name": "discovery.capture_recovery.v1",
                      "digest": "6a6301569ded543c150633b65283af6dd34da5afab4f2da8267752ca65ceaf4c",
                      "kind": "integration",
                      "inputs": [
                        {
                          "semantic": "discovery.url.v1",
