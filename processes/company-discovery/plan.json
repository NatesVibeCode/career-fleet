  "process": {
    "name": "company_discovery.v1",
    "policy": {
      "execution_journal": "praxis.execution_journal.v2",
      "allowed_effects": [
        "network.read"
      ],
      "acceptance": {
        "schema": "discovery.acceptance.v1",
        "outcome": "Generic deterministic source-bound discovery with visible unknowns",
        "requirements": [
          "No personal defaults",
          "Zero inference calls",
          "Preserve all discovered candidates",
          "Unknown evidence never rejects a candidate",
          "Fair finite question acquisition",
          "Retain original response bytes and typed source failures",
          "Exact text spans for lexical and field extraction",
          "No factory runtime dependency"
        ]
      },
      "recovery": {
        "schema": "praxis.process_recovery.v2",
        "bindings": [
          {
            "semantics": "observation",
            "target": {
              "block": "acquire",
              "node": "capture"
            },
            "reconciler": {
              "key": "capture_observation",
              "ref": {
                "name": "discovery.capture_observation.block.v1",
                "digest": "e514301abcce9544bbc98c369d07cb043e2b722aab5ee4d777d1cab81dfb62f9"
              },
