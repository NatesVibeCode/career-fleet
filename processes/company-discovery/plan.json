                          },
                          "required": true
                        },
                        {
                          "semantic": "recovery.status",
                          "name": "status",
                          "type": {
                            "enum": [
                              "completed",
                              "unknown"
                            ],
                            "type": "string"
                          },
                          "required": true
                        }
                      ]
                    }
                  }
